# Example: one public HTTPS origin for the React site, /admin and existing Nest API.
# Replace example.com, SSL config, static folder with YOUR environment.
# The NestJS backend remains on localhost:3004 and is NOT exposed publicly.
server {
    listen 80;
    server_name example.com;
    # Terminate TLS in your production configuration before accepting credentials.
    root /var/www/ratan-lal-saraf/dist;
    index index.html;

    location /backend/ {
        proxy_pass http://127.0.0.1:3004/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cookie_path /api /backend;
        proxy_no_cache 1;
        add_header Cache-Control 'no-store' always;
    }

    # Only configure this if your existing backend serves images from /uploads/.
    location /assets-api/ {
        proxy_pass http://127.0.0.1:3004/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
