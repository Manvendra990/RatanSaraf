{
  "name": "ratan-saraf-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --require ts-node/register src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "db:setup": "prisma generate && prisma migrate deploy && npm run db:seed",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "test:mysql": "npm run build && node --import tsx scripts/integration.mysql.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:studio": "prisma studio",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:baseline:check": "node --import tsx scripts/check-baseline.ts",
    "postinstall": "prisma generate",
    "db:baseline": "node --import tsx scripts/check-baseline.ts --apply",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "env:check": "node scripts/check-env.cjs",
    "predev": "node scripts/check-env.cjs",
    "prestart": "node scripts/check-env.cjs",
    "predb:setup": "node scripts/check-env.cjs",
    "predb:migrate": "node scripts/check-env.cjs",
    "predb:seed": "node scripts/check-env.cjs",
    "predb:baseline": "node scripts/check-env.cjs",
    "predb:baseline:check": "node scripts/check-env.cjs",
    "kyc:key": "node scripts/init-kyc-key.cjs",
    "db:upgrade": "node --import tsx scripts/upgrade-db.ts",
    "predb:upgrade": "node scripts/check-env.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "bcryptjs": "^3.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "express-rate-limit": "^7.5.0",
    "@prisma/client": "6.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/express": "^5.0.0",
    "@types/cookie-parser": "^1.4.8",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "ts-node": "^10.9.2",
    "mysql2": "^3.12.0",
    "prisma": "6.19.0"
  },
  "overrides": {
    "multer": "^2.5.0",
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.20.0"
  }
}
