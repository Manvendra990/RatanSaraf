# # Local dev: proxy to the EXACT SAME backend used by the Expo mobile app.
# VITE_BACKEND_TARGET=http://localhost:3004
# # Set to an empty value if your Nest server exposes /catalog (not /api/catalog).
# VITE_BACKEND_API_PREFIX=/api
# # Set this to your production API URL when deploying if not reverse-proxying /backend.
# VITE_API_BASE_URL=/backend
# # Images from the API may be /uploads/...; this forwards to backend root (without /api).
# VITE_MEDIA_BASE_URL=/assets-api

# # Auth endpoints are NOT present in the supplied src-only archive. Update to
# # the existing backend's actual routes (no second auth server is created).
# VITE_LOGIN_PATH=/auth/login
# VITE_REGISTER_PATH=/auth/register

# # Optional: if store settings do not already expose a WhatsApp number.
# VITE_STORE_WHATSAPP=

VITE_BACKEND_TARGET=http://localhost:3004
VITE_BACKEND_API_PREFIX=/api

VITE_API_BASE_URL=/backend
VITE_MEDIA_BASE_URL=/assets-api

VITE_LOGIN_PATH=/auth/login
VITE_REGISTER_PATH=/auth/register

VITE_STORE_WHATSAPP=63xxxxxxxx